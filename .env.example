# ==============================================================================
# Calibration Commercial Module (CCM) - Environment Configuration Template
# ==============================================================================
# IMPORTANT: Copy this file to `.env` for local development.
# NEVER commit production passwords, JWT signing keys, or private API keys to Git.

# ------------------------------------------------------------------------------
# 1. SUPABASE / POSTGRESQL DATABASE & RLS CONFIGURATION
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 2. CLOUDFLARE WORKERS API GATEWAY & SECURITY
# ------------------------------------------------------------------------------
PORT=8787
API_GATEWAY_URL=http://localhost:8787
JWT_SECRET=your-super-secret-jwt-signing-key-minimum-32-chars-long
ENABLE_RATE_LIMITING=true
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE R2 PRIVATE STORAGE & SIGNED URLS
# ------------------------------------------------------------------------------
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ccm-secure-artifacts
R2_PUBLIC_URL_PREFIX=https://artifacts.ccm.internal

# ------------------------------------------------------------------------------
# 4. FRONTEND PUBLIC ENVIRONMENT VARIABLES (Vite Client Prefixes)
# ------------------------------------------------------------------------------
# NOTE: Only variables prefixed with VITE_ are exposed to the browser bundle.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder
VITE_API_GATEWAY_URL=http://localhost:8787/api/v1
VITE_ENABLE_MOCK_FALLBACK=true
VITE_APP_ENV=development
