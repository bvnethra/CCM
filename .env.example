# ==============================================================================
# Calibration Commercial Module (CCM) - Environment Configuration
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
# Found in your Supabase project settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres

# --- CLOUDFLARE WORKERS API GATEWAY ---
PORT=8787
API_GATEWAY_URL=http://localhost:8787
JWT_SECRET=super-secret-jwt-signing-key-for-ccm-calibration-enterprise

# --- CLOUDFLARE R2 STORAGE (PRIVATE/SIGNED URL ARCHITECTURE) ---
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=ccm-secure-artifacts
R2_PUBLIC_URL_PREFIX=https://artifacts.ccm.internal

# --- FRONTEND CLIENT VARIABLES (Vite prefixes) ---
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_API_GATEWAY_URL=http://localhost:8787/api/v1
VITE_ENABLE_MOCK_FALLBACK=true
